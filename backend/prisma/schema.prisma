datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hashed with bcrypt or secure string
  name      String
  role      String   @default("staff") // "owner" | "admin" | "staff" | "teacher"
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  phone            String             @unique
  password         String
  avatarUrl        String?
  classId          String?            // e.g. "Class 12"
  targetExam       String?            // e.g. "NEET 2026"
  isActive         Boolean            @default(true)
  token            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  doubts           Doubt[]
  videoComments    VideoComment[]
  communityPosts   CommunityPost[]
  communityLikes   CommunityLike[]
  communityComments CommunityComment[]
  orders           Order[]
  deletionRequests DeletionRequest[]
}

model Category {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  icon       String       @default("school")
  color      Int          @default(10619899) // 0xFF00897B
  order      Int          @default(0)
  createdAt  DateTime     @default(now())

  courses    Course[]
  testSeries TestSeries[]
}

model Course {
  id                   Int            @id @default(autoincrement())
  title                String
  slug                 String         @unique
  description          String?
  thumbnailUrl         String?
  price                Float          @default(0.0)
  discountPrice        Float?
  instructorName       String?
  categoryId           Int?
  category             Category?      @relation(fields: [categoryId], references: [id])
  validityDays         Int            @default(365)
  isPublished          Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  folders              CourseFolder[]
  enrollments          Enrollment[]
  orders               Order[]
}

model CourseFolder {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  lessons   Lesson[]
}

model Lesson {
  id              Int            @id @default(autoincrement())
  folderId        Int
  folder          CourseFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  videoId         String         // YouTube ID or stream URL
  durationMinutes Int            @default(0)
  isFreePreview   Boolean        @default(false)
  order           Int            @default(0)
  pdfUrl          String?
  createdAt       DateTime       @default(now())

  comments        VideoComment[]
}

model VideoComment {
  id             Int      @id @default(autoincrement())
  lessonId       Int
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId      Int?
  student        Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentName    String
  studentAvatar  String?
  comment        String
  likesCount     Int      @default(0)
  isTeacherReply Boolean  @default(false)
  videoId        String?
  createdAt      DateTime @default(now())
}

model TestSeries {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  categoryId    Int?
  category      Category?    @relation(fields: [categoryId], references: [id])
  thumbnailUrl  String?
  price         Float        @default(0.0)
  discountPrice Float?
  validityDays  Int          @default(365)
  isPublished   Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  quizzes       Quiz[]
  enrollments   Enrollment[]
  orders        Order[]
}

model Quiz {
  id              Int           @id @default(autoincrement())
  testSeriesId    Int?
  testSeries      TestSeries?   @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)
  title           String
  subject         String?
  durationMinutes Int           @default(60)
  totalMarks      Float         @default(40.0)
  negativeMarks   Float         @default(1.0)
  passingMarks    Float         @default(16.0)
  isFree          Boolean       @default(false)
  isLocked        Boolean       @default(false)
  maxAttempts     Int           @default(3)
  instructions    String?       // JSON array string
  isPublished     Boolean       @default(true)
  createdAt       DateTime      @default(now())

  questions       Question[]
  attempts        QuizAttempt[]
}

model Question {
  id               Int      @id @default(autoincrement())
  quizId           Int
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionNumber   Int      @default(1)
  questionText     String
  questionImageUrl String?
  options          String   // JSON array of strings
  optionImages     String?  // JSON array of string | null
  correctOption    Int      // 0-indexed integer
  explanation      String?
  subject          String?
  topic            String?
  marks            Float    @default(4.0)
  negativeMarks    Float    @default(1.0)
  createdAt        DateTime @default(now())
}

model QuizAttempt {
  id                Int      @id @default(autoincrement())
  quizId            Int
  quiz              Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId         Int
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score             Float
  totalMarks        Float
  correctAnswers    Int
  incorrectAnswers  Int
  unattempted       Int
  accuracy          Float
  timeTakenSeconds  Int
  rank              Int      @default(1)
  totalParticipants Int      @default(1)
  percentile        Float    @default(100.0)
  isPassed          Boolean  @default(true)
  certificateUrl    String?
  answers           String   // JSON object: { [questionId: string]: number }
  createdAt         DateTime @default(now())
}

model Doubt {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName   String
  question      String
  createdAt     DateTime @default(now())
}

model Enrollment {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    Int?
  course      Course?   @relation(fields: [courseId], references: [id])
  testSeriesId Int?
  testSeries   TestSeries? @relation(fields: [testSeriesId], references: [id])
  createdAt   DateTime @default(now())
}

model Order {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    Int?
  course      Course?   @relation(fields: [courseId], references: [id])
  testSeriesId Int?
  testSeries   TestSeries? @relation(fields: [testSeriesId], references: [id])
  amount      Float    @default(0.0)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model CommunityPost {
  id          Int      @id @default(autoincrement())
  authorId    Int
  author      Student   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
}

model CommunityComment {
  id          Int      @id @default(autoincrement())
  postId      Int
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    Int
  author      Student   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
}

model CommunityLike {
  id          Int      @id @default(autoincrement())
  postId      Int
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      Int
  user        Student   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeletionRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        Student   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String
  createdAt   DateTime @default(now())
}
